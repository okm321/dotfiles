#!/bin/sh
# claude ラッパー: cwd から .claude-config-dir マーカーを上に向かって探し、
# 見つかればその中身を CLAUDE_CONFIG_DIR にして本体を起動する。
# zsh 関数ではなく PATH 上の shim にしているのは、tmux の pane command や
# workmux 経由など対話シェルを通らない起動でも効かせるため。
dir="$PWD"
while [ "$dir" != "/" ]; do
  if [ -f "$dir/.claude-config-dir" ]; then
    CLAUDE_CONFIG_DIR="$(cat "$dir/.claude-config-dir")"
    export CLAUDE_CONFIG_DIR
    break
  fi
  dir="$(dirname "$dir")"
done
exec "$HOME/.local/bin/claude" "$@"
