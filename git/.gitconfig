[alias]
	# 現在いるブランチ名を取得して push する
	ps = "!git push origin $(git rev-parse --abbrev-ref @)"

[init]
	defaultBranch = main

[push]
	default = current
	autoSetupRemote = true

[fetch]
	prune = true

[core]
	pager = git-split-diffs --color | less -RFX

[delta]
	side-by-side = true
	syntax-theme = Nord
	line-numbers = true

[credential]
	helper = store

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[ghq]
	root = ~/project

# 個人情報 (user.name, user.email) は公開 repo に入れない
[include]
	path = ~/dotfiles/git/user.conf
